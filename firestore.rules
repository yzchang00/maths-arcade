rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then press Publish.
// Only the admin email below can open the tracker, see every pupil or delete leaderboard entries. Everything not listed here is blocked.
// Teachers (optional, added later): a document in staff/{their email} = { role: "teacher", classes: ["5B", "6A"] } lets that Google
// account read the profiles and game history of pupils in those classes only. Only the admin can create or change staff documents.
// Every device signs in with an invisible anonymous ID (Authentication → Anonymous must be ON), so a device can only change its own entries.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ["xxyanzhangxx@gmail.com"];   // admin: only Yan
    }
    function isTeacher() { return isAdmin(); }   // older rules below use this name
    // A teacher who has been given this class by the admin (see staff/{email}).
    function teaches(cls) {
      return request.auth != null && request.auth.token.email_verified == true
        && cls is string && cls != ''
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email))
        && cls in get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.classes;
    }
    // Signed in with a real account (Google), not the invisible anonymous ID.
    function hasAccount() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function signedIn() { return request.auth != null; }
    function shortText(v, n) { return v is string && v.size() <= n; }
    // Server-side backstop for the worst words (the website has a fuller filter; this stops anyone bypassing it).
    function cleanName(v) {
      return !(v is string) || !v.lower().matches('.*(n+[i1!|]+g+[e3]+r|n+[i1!|]+gg+[a@]+|f+[u*v]+c+k|f+u+k|c+u+n+t|ch?[i1]+ba[i1]|lanj[i1]+a?o|puk[i1]+mak|kan[i1]+na|b[i1]+tch|wh[o0]+re|sl[u*]+t|p[o0]+rn).*');
    }
    // Highest possible score in each game (normal games: 10 points × rounds). A new game must be added here, or its scores are refused.
    function maxScore() {
      return {
        'p4-rounding': 90, 'p4-factors': 80, 'p4-product': 90, 'p4-flip': 30, 'p4-share': 80, 'p4-target': 100,
        'p4-decimals': 80, 'p4-cashier': 80, 'p4-garden': 80, 'p4-angles': 100, 'p4-mirror': 80, 'p4-nets': 100,
        'p4-graphs': 100, 'p5-vault': 20000, 'p5-order': 80, 'p5-slide': 80, 'p5-share': 80, 'p5-fgrid': 80,
        'p5-rate': 80, 'p5-tarea': 80, 'p5-volume': 80, 'p5-angles': 80, 'p5-triangles': 80, 'p5-quads': 80,
        'p6-fdiv': 80, 'p6-pchange': 80, 'p6-ratio': 80, 'p6-algebra': 80, 'p6-circle': 80, 'p6-cuberoot': 80,
        'p6-chain': 80, 'p6-average': 80, 'p4-diner': 80, 'p4-train': 80, 'p4-compass': 80, 'p5-pizza': 80,
        'p5-pshop': 80, 'p6-pie': 80, 'party-tug': 1000, 'party-bingo': 1000, 'party-wall': 1000, 'p6-quest': 100,
        'party-team': 1000, 'sg-journeys': 80, 'sg-journeys-2': 80, 'world-journeys': 80, 's1-primes': 80, 's1-integers': 80, 's1-estimate': 80, 's1-bouncer': 80
      };
    }
    // Class: empty, or letters/numbers/dash starting with a letter or number (5B, P5-2, 6E1).
    function okClass(c) { return c is string && c.matches('^([A-Z0-9][A-Z0-9-]{0,7})?$'); }

    // Leaderboard: one document per player per game per difficulty with their best score.
    // Anyone can read. Only the device that first saved a name can raise its score (or stars). Only the teacher can delete.
    function validScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['game','title','level','diff','nick','cls','score','stars','mode','ts','uid'])
        && d.uid == request.auth.uid
        && d.game in maxScore()
        && shortText(d.title, 60) && shortText(d.level, 12) && d.mode in ['solo','bot','online']
        && d.diff in ['easy','mixed','hard','-']
        && d.nick is string && d.nick.size() >= 2 && d.nick.size() <= 14
        && okClass(d.cls) && cleanName(d.nick) && cleanName(d.cls)
        && d.score is int && d.score >= 0 && d.score <= maxScore()[d.game]
        && d.stars is int && d.stars >= -1 && d.stars <= 3
        && (d.stars < 3 || d.score * 100 >= maxScore()[d.game] * 85)
        && d.ts == request.time;
    }
    match /scores/{id} {
      allow read: if true;
      allow create: if signedIn() && validScore();
      allow update: if signedIn() && validScore()
        && (!('uid' in resource.data) || resource.data.uid == request.auth.uid)
        && (request.resource.data.score > resource.data.score || request.resource.data.stars > resource.data.stars
            || (!('uid' in resource.data) && request.resource.data.score == resource.data.score))
        && request.resource.data.nick == resource.data.nick && request.resource.data.cls == resource.data.cls
        && request.resource.data.game == resource.data.game;
      allow delete: if isTeacher();
    }

    // Usage log: devices can add entries; only the teacher can read or delete them.
    match /visits/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['event','game','score','nick','cls','sid','device','ts'])
        && request.resource.data.score is int && request.resource.data.score >= -1 && request.resource.data.score <= 1000
        && shortText(request.resource.data.event, 10) && shortText(request.resource.data.game, 40)
        && shortText(request.resource.data.nick, 14) && shortText(request.resource.data.cls, 8)
        && cleanName(request.resource.data.nick) && cleanName(request.resource.data.cls)
        && shortText(request.resource.data.sid, 12) && shortText(request.resource.data.device, 10)
        && request.resource.data.ts == request.time;
      allow read, delete: if isTeacher();
      allow update: if false;
    }

    // Feedback sent from Ask Qubi. Anyone on the site (guest or signed in) can send it; only the admin can read it,
    // mark it done or delete it. Pictures and small files are stored inside the document itself (Cloud Storage needs the
    // paid plan), so a whole feedback document must stay under Firestore's 1 MB limit.
    match /feedback/{id} {
      function okFile(f) {
        return f is map && f.keys().hasOnly(['name','type','data']) && shortText(f.name, 80) && shortText(f.type, 80)
          && f.data is string && f.data.size() <= 700000;
      }
      function okFb() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid','kind','msg','page','game','round','level','mode','nick','cls','signed','screen','files','status','ts'])
          && d.uid == request.auth.uid && shortText(d.kind, 20) && shortText(d.msg, 1000)
          && shortText(d.page, 60) && shortText(d.game, 60) && shortText(d.round, 40) && shortText(d.level, 20) && shortText(d.mode, 12)
          && shortText(d.nick, 14) && shortText(d.cls, 8) && d.signed is bool && shortText(d.screen, 20)
          && d.files is list && d.files.size() <= 2
          && (d.files.size() < 1 || okFile(d.files[0])) && (d.files.size() < 2 || okFile(d.files[1]))
          && (d.msg.size() > 0 || d.files.size() > 0)
          && d.status == 'new' && d.ts == request.time;
      }
      allow create: if request.auth != null && okFb();
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'done'];
    }

    // Staff list. Only the admin can change it; a teacher can read their own entry.
    match /staff/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Profile of a pupil who signed in with Google: who they are, and when they first and last came.
    // The pupil writes their own; the admin (or a teacher of their class) can read it.
    match /users/{uid} {
      function okUser() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','email','nick','cls','first','last'])
          && shortText(d.name, 60) && shortText(d.email, 100) && d.email == request.auth.token.email
          && shortText(d.nick, 14) && shortText(d.cls, 8) && cleanName(d.nick) && cleanName(d.cls)
          && d.last == request.time;
      }
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin() || teaches(resource.data.cls);
      allow create: if hasAccount() && request.auth.uid == uid && okUser() && request.resource.data.first == request.time;
      allow update: if hasAccount() && request.auth.uid == uid && okUser() && request.resource.data.first == resource.data.first;
      allow delete: if isAdmin();
    }

    // Game history of signed-in pupils: one document per finished game. Never changed after it is written.
    match /plays/{id} {
      function okPlay() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid','nick','cls','game','title','level','strand','topic','diff','mode','score','max','stars','res','rt','ts'])
          && d.uid == request.auth.uid
          && shortText(d.nick, 14) && shortText(d.cls, 8) && cleanName(d.nick) && cleanName(d.cls)
          && shortText(d.game, 40) && shortText(d.title, 60) && shortText(d.level, 12) && shortText(d.strand, 12) && shortText(d.topic, 80)
          && shortText(d.diff, 8) && shortText(d.mode, 8)
          && d.score is int && d.score >= 0 && d.score <= 20000 && d.max is int && d.max >= 0 && d.max <= 20000
          && d.stars is int && d.stars >= -1 && d.stars <= 3
          && shortText(d.res, 40) && d.res.matches('^[0-2]*$') && shortText(d.rt, 120)
          && d.ts == request.time;
      }
      allow create: if hasAccount() && okPlay();
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin() || teaches(resource.data.cls);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Saved progress for pupils who sign in with Google: each pupil can only read and write their own.
    match /players/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['p','ts'])
        && request.resource.data.p is map && request.resource.data.p.size() <= 400
        && request.resource.data.ts == request.time;
    }

    // Online rooms: one small document per player in rooms/arc-<code>/p/<their ID>_<tab>.
    // A device can only create, change or delete its own document. "joined" is stamped by the server once and never changes,
    // which is how everyone agrees who the host is (whoever joined first).
    match /rooms/{room}/p/{pid} {
      function mine() { return signedIn() && pid.split('_')[0] == request.auth.uid; }
      function okPresence() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nick','code','status','score','round','game','level','startAt','seed','seen','joined','topic','team','teams'])
          && d.seen == request.time
          && (!('nick' in d) || (shortText(d.nick, 16) && cleanName(d.nick)))
          && (!('game' in d) || d.game == null || d.game in maxScore())
          && (!('level' in d) || d.level == null || d.level in ['easy','mixed','hard'])
          && (!('status' in d) || d.status in ['lobby','playing','done','away'])
          && (!('score' in d) || (d.score is int && d.score >= 0 && d.score <= 1000))
          && (!('topic' in d) || d.topic == null || shortText(d.topic, 12))
          && (!('team' in d) || (d.team is int && d.team >= 0 && d.team <= 3))
          && (!('teams' in d) || (d.teams is int && d.teams >= 2 && d.teams <= 4));
      }
      allow read: if room.matches('arc-[a-z0-9]{4}');
      allow create: if room.matches('arc-[a-z0-9]{4}') && mine() && okPresence() && request.resource.data.joined == request.time;
      allow update: if mine() && okPresence() && request.resource.data.joined == resource.data.joined;
      allow delete: if mine();
    }
  }
}
