rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then press Publish.
// Only the email below can open the tracker or delete leaderboard entries. Everything not listed here is blocked.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ["xxyanzhangxx@gmail.com"];   // admin: only Yan
    }
    function shortText(v, n) { return v is string && v.size() <= n; }

    // Leaderboard: one document per player per game per difficulty with their best score.
    // Anyone can read; a score can only be replaced by a HIGHER score (or more stars) for the same player; only teachers can delete.
    function validScore() {
      return request.resource.data.keys().hasOnly(['game','title','level','diff','nick','cls','score','stars','mode','ts'])
        && shortText(request.resource.data.game, 40) && shortText(request.resource.data.title, 60)
        && shortText(request.resource.data.level, 12) && shortText(request.resource.data.mode, 8)
        && (!('diff' in request.resource.data) || shortText(request.resource.data.diff, 8))
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 14
        && shortText(request.resource.data.cls, 8)
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1000
        && request.resource.data.stars is int && request.resource.data.stars >= -1 && request.resource.data.stars <= 3
        && request.resource.data.ts == request.time;
    }
    match /scores/{id} {
      allow read: if true;
      allow create: if validScore();
      allow update: if validScore() && (request.resource.data.score > resource.data.score || request.resource.data.stars > resource.data.stars)
        && request.resource.data.nick == resource.data.nick && request.resource.data.cls == resource.data.cls
        && request.resource.data.game == resource.data.game;
      allow delete: if isTeacher();
    }

    // Usage log: the website can add entries; only teachers can read or delete them.
    match /visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['event','game','score','nick','cls','sid','device','ts'])
        && request.resource.data.score is int && request.resource.data.score >= -1 && request.resource.data.score <= 1000
        && shortText(request.resource.data.event, 10) && shortText(request.resource.data.game, 40)
        && shortText(request.resource.data.nick, 14) && shortText(request.resource.data.cls, 8)
        && shortText(request.resource.data.sid, 12) && shortText(request.resource.data.device, 10)
        && request.resource.data.ts == request.time;
      allow read, delete: if isTeacher();
      allow update: if false;
    }

    // Saved progress for pupils who sign in with Google: each pupil can only read and write their own.
    match /players/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['p','ts'])
        && request.resource.data.p is map && request.resource.data.p.size() <= 400
        && request.resource.data.ts == request.time;
    }
    // Online rooms: one small document per player in rooms/arc-<code>/p/<player>. Short-lived; players delete their own when they leave.
    match /rooms/{room}/p/{pid} {
      allow read: if room.matches('arc-[a-z0-9]{4}');
      allow create, update: if room.matches('arc-[a-z0-9]{4}')
        && request.resource.data.keys().hasOnly(['nick','code','host','status','score','round','game','level','startAt','seed','seen'])
        && request.resource.data.seen == request.time
        && (!('nick' in request.resource.data) || shortText(request.resource.data.nick, 16))
        && (!('game' in request.resource.data) || request.resource.data.game == null || shortText(request.resource.data.game, 40))
        && (!('status' in request.resource.data) || shortText(request.resource.data.status, 10));
      allow delete: if true;
    }
  }
}
